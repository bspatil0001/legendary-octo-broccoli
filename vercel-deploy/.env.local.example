# NoBroker API Credentials
NOBROKER_TOKEN=your_nobroker_api_token_here
NOBROKER_COOKIES=your_nobroker_cookies_here

# Cron Security
CRON_SECRET=your_random_secret_key_here

# App Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional for local development; without it, JSON logs are stored in ./data.
# Vercel deployments require a connected Blob store that provides this token.
# BLOB_READ_WRITE_TOKEN=
